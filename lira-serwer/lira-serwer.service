# systemd --user unit. Install:
#   mkdir -p ~/.config/systemd/user && cp lira-serwer.service ~/.config/systemd/user/
#   (edit ExecStart: path to lira_serwer.py and to your python / venv)
#   systemctl --user daemon-reload && systemctl --user enable --now lira-serwer
[Unit]
Description=Lira music server (local)
After=network-online.target sound.target

[Service]
ExecStart=%h/lira/lira-serwer/venv/bin/python %h/lira/lira-serwer/lira_serwer.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
